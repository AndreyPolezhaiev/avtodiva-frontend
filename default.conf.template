server {
    listen ${NGINX_PORT};
    
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /api {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/analytics {
        # resolve at request time so nginx starts even if the analytics service is down
        resolver 127.0.0.11 valid=10s;
        set $analytics_upstream http://${ANALYTICS_HOST}:${ANALYTICS_PORT};
        proxy_pass $analytics_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
